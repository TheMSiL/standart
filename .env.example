# Public site URL — used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.standardbuild.com"

# --- Lead delivery (server-only, never exposed to the browser) -------------
# The lead pipeline in src/lib/leads.ts fans a submitted lead out to every
# transport that is configured. Leave a variable empty to disable it.

# Generic webhook (Zapier / Make / n8n / custom CRM endpoint)
LEADS_WEBHOOK_URL=""

# Transactional email (e.g. Resend). Also works with any SMTP relay adapter.
RESEND_API_KEY=""
LEADS_EMAIL_TO="estimates@standardbuild.com"
LEADS_EMAIL_FROM="website@standardbuild.com"

# --- Geo gating -------------------------------------------------------------
# Set to "true" to restrict the site to US visitors (see middleware.ts).
GEO_RESTRICT_ENABLED="false"
GEO_ALLOWED_COUNTRIES="US"
