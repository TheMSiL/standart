# Normalise line endings: LF in the repository, native in the working copy.
# Keeps diffs clean between Windows checkouts and the Linux build on Vercel.
* text=auto eol=lf

# Binary assets — never touch these.
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
